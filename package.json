{
  "name": "booking-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --timeout=30000 --preload ./tests/setup.ts --parallel=1",
    "test:watch": "bun test --watch --timeout=30000 --preload ./tests/setup.ts --parallel=1",
    "test:server": "bun run src/run-test-server.ts"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.1.2",
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/jwt": "^1.1.1",
    "@elysiajs/openapi": "^1.4.15",
    "bullmq": "6.2.0",
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.1.26",
    "ioredis": "6.0.0",
    "nodemailer": "9.0.5",
    "postgres": "^3.4.5",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.1",
    "bun-types": "latest",
    "drizzle-kit": "^0.28.1",
    "typescript": "5.9.2"
  }
}
