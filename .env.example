PORT=3000
# RUN_MODE menentukan proses apa yang dijalankan: "all" (default, server+worker bareng, dipakai untuk deploy 1 service di tier gratis), "api" (server saja), atau "worker" (worker saja). Kosongkan/hapus baris ini untuk pakai default "all".
RUN_MODE=all
DATABASE_URL=postgres://postgres:postgres@localhost:5432/booking_db
JWT_SECRET=ganti-dengan-secret-yang-kuat

# Origin frontend yang boleh memanggil API ini dari browser (daftar origin dipisah
# koma, TANPA spasi setelah koma dan TANPA garis miring di akhir).
# WAJIB diisi di production — kalau kosong, hanya origin localhost dev yang
# diizinkan dan frontend production akan mendapat CORS error.
# Contoh: CORS_ALLOWED_ORIGINS=https://booking.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Background job email (BullMQ + Redis)
REDIS_URL=redis://localhost:6379

# Pengiriman email. MAIL_PROVIDER menentukan transport yang dipakai:
#   smtp    (default) -> localhost:1025, yaitu Mailpit untuk development
#   mailgun            -> SMTP Mailgun, untuk production
# Nilai yang tidak dikenali akan membuat worker BERHENTI start, bukan fallback diam-diam.
MAIL_PROVIDER=smtp
MAIL_FROM="Booking App <no-reply@example.com>"

# Hanya dipakai saat MAIL_PROVIDER=smtp (development / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Hanya dipakai saat MAIL_PROVIDER=mailgun (production). Keempatnya wajib —
# worker berhenti start kalau salah satu kosong. Isi dengan kredensial SMTP
# yang diberikan Mailgun di menu Sending > SMTP credentials.
# DEMO_EMAIL: satu-satunya alamat yang boleh menerima email di produksi. Job tetap
# dibuat dan diproses untuk semua user, tetapi kiriman ke alamat lain dilewati agar
# kuota free tier Mailgun tidak habis dipakai traffic demo.
# PENTING: domain pada MAIL_FROM harus sudah terverifikasi di Mailgun, kalau tidak
# email akan ditolak.
MAILGUN_SMTP_HOST=
MAILGUN_SMTP_PORT=
MAILGUN_SMTP_LOGIN=
MAILGUN_SMTP_PASSWORD=
DEMO_EMAIL=

# Pembayaran simulasi Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_ganti-dengan-test-key-anda
STRIPE_WEBHOOK_SECRET=whsec_ganti-dengan-webhook-secret-anda
PAYMENT_CURRENCY=idr
PAYMENT_EXPIRY_MINUTES=15
PAYMENT_SUCCESS_URL=http://localhost:5173/payments/success
PAYMENT_CANCEL_URL=http://localhost:5173/payments/cancel

# Auth token TTL
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Admin account (digunakan oleh db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-yang-kuat
